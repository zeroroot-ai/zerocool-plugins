# syntax=docker/dockerfile:1
# The zerocool Claude agent image (gibson#1706, ADR-0008, ADR-0016).
#
# One image, two shapes, selected by the manifest command (gibson#1717):
#
#   /app/dist/sandbox.js      one-shot: one dispatched Task, one auto-closed job
#   /app/dist/member-main.js  member:   always-on, pulls jobs from its bank
#
# It carries the unmodified Claude Code CLI, the Gibson MCP server, and the
# member driver. The Claude Code binary is installed as Anthropic publishes it
# and is never modified: the hosting terms require that, and they require the
# end user's own credential, which the launch injects or the person signs in
# with inside the sandbox.
#
# Non-root: Claude Code refuses --dangerously-skip-permissions as root, and the
# gVisor sandbox is the permission boundary. The daemon states that boundary
# with GIBSON_SANDBOX=gvisor on the launch; the driver refuses to start
# without it (packages/claude-member/src/env.ts). The image does not set the
# marker itself: an image run outside gVisor must not claim the sandbox.
#
# Every third-party input is pinned by hash (Scorecard Pinned-Dependencies,
# zerocool-plugins#13): the base image by digest, and the Claude Code CLI plus
# the Gibson MCP server (the one tool surface for every host, ADR-0008)
# through tools/claude/package-lock.json (npm ci). The Claude Code version
# there is the one the stream-json fixtures in packages/claude-member/test/
# fixtures came from; a bump re-captures them (test/fixtures/README.md).

FROM node:26.9.0-trixie-slim@sha256:3a771f83944bb763050c23c0225c260638c4b7899e7a72485ef75e5e570499e5 AS build
WORKDIR /src
# Node 25 and later ship no corepack. pnpm comes from tools/pnpm, hash
# pinned, at the version the root package.json names as packageManager.
COPY tools/pnpm/package.json tools/pnpm/package-lock.json /opt/pnpm/
RUN cd /opt/pnpm \
 && npm ci --omit=dev --no-audit --no-fund \
 && ln -s /opt/pnpm/node_modules/.bin/pnpm /usr/local/bin/pnpm \
 && pnpm --version
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml tsconfig.base.json ./
COPY packages ./packages
RUN --mount=type=cache,target=/root/.local/share/pnpm/store pnpm install --frozen-lockfile
RUN pnpm -r build
RUN pnpm --filter @zeroroot-ai/zerocool-claude-member deploy --prod --legacy /app

FROM node:26.9.0-trixie-slim@sha256:3a771f83944bb763050c23c0225c260638c4b7899e7a72485ef75e5e570499e5 AS runtime
# State lives under /tmp. The setec sandbox this image is built for mounts a
# read-only root filesystem, and /tmp is the scratch volume every sandbox
# gets, so /home/claude is never writable there. The driver defaults to the
# same path under the sandbox marker and refuses to start when the state dir
# takes no write (packages/claude-member/src/env.ts). The Claude config dir
# sits inside it: the subscription login dies with the sandbox, as documented.
ENV NODE_ENV=production \
    ZEROCOOL_CLAUDE_BIN=claude \
    ZEROCOOL_MCP_BIN=gibson-mcp \
    ZEROCOOL_AGENT_NAME=claude \
    CLAUDE_CONFIG_DIR=/tmp/zerocool/claude-config \
    CLAUDE_CODE_DISABLE_AUTO_MEMORY=1 \
    ZEROCOOL_STATE_DIR=/tmp/zerocool \
    ZEROCOOL_WORKSPACE=/workspace
# The npm node bundles is whatever node shipped that day; npm 10's bundled
# tar, minimatch, glob and friends carried fixed CVEs (Trivy, #13).
# tools/npm/package-lock.json pins npm by hash. It replaces the bundled copy
# before anything else installs, and it stays in the image so `claude` can start npx-based MCP servers a person adds.
COPY tools/npm/package.json tools/npm/package-lock.json /opt/npm/
RUN cd /opt/npm \
 && npm ci --omit=dev --no-audit --no-fund \
 && cd / \
 && rm -rf /usr/local/lib/node_modules/npm \
 && mv /opt/npm/node_modules/npm /usr/local/lib/node_modules/npm \
 && rm -rf /opt/npm \
 && npm cache clean --force \
 && npm --version
COPY tools/claude/package.json tools/claude/package-lock.json /opt/claude/
# APT_CACHE_BUST + `apt-get upgrade` — why the base packages were stale.
#
# This image ships gzip, libpcre2-8-0 and libsqlite3-0 one Debian point release
# behind, which is 5 of its 10 critical/high Trivy findings. The base is
# digest-pinned, so it is only as current as the day that digest was built, and
# nothing here ever applied the distro's own security updates.
#
# `apt-get upgrade` alone is not enough either: the layer is cached by buildx
# (cache-from: type=gha) on instruction text plus base digest, so it would run
# once and be replayed forever. Measured on gibson-executor the same day — an
# accidental cache-less build produced patched packages, the next cached build
# put them back. The caller passes a value that changes every run.
ARG APT_CACHE_BUST=0
RUN echo "apt refresh ${APT_CACHE_BUST}" >/dev/null \
 && apt-get update \
 && apt-get upgrade -y --no-install-recommends \
 && apt-get install -y --no-install-recommends git ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && cd /opt/claude \
 && npm ci --omit=dev --no-audit --no-fund \
 && npm cache clean --force \
 && ln -s /opt/claude/node_modules/.bin/claude /usr/local/bin/claude \
 && ln -s /opt/claude/node_modules/.bin/gibson-mcp /usr/local/bin/gibson-mcp \
 && claude --version \
 && gibson-mcp --version
COPY --from=build /app /app
RUN useradd -u 65532 -m -d /home/claude claude \
 && mkdir -p /workspace \
 && chown -R 65532:65532 /workspace /app /home/claude
WORKDIR /workspace
USER 65532:65532

# The license text travels with the distribution. Apache-2.0 §4(a) and MIT
# both require the notice to reach every recipient, and a published image is
# a distribution. /licenses is the OCI convention. Each Dockerfile needs its
# own copy: the two images share a base, not a final stage. Last in the stage
# so a change here rebuilds nothing else.
COPY LICENSE /licenses/LICENSE
COPY NOTICE /licenses/NOTICE

# The one-shot shape is the default. A member sandbox overrides the command.
ENTRYPOINT ["node", "/app/dist/sandbox.js"]
