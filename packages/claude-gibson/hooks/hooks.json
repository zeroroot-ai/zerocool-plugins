{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/zerocool-claude-hook.mjs"],
            "timeout": 30,
            "statusMessage": "Loading Gibson context"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/zerocool-claude-hook.mjs"],
            "timeout": 60
          }
        ]
      }
    ]
  }
}
