{
  "name": "@zeroroot-ai/zerocool",
  "version": "0.9.0",
  "description": "opencode host adapter for Gibson (zerocool): zero-config LLM through the harness, ambient knowledge, and the Gibson MCP server registered for you. The tools come from @zeroroot-ai/gibson-mcp.",
  "license": "Elastic-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zeroroot-ai/zerocool-plugins.git",
    "directory": "packages/opencode-gibson"
  },
  "homepage": "https://github.com/zeroroot-ai/zerocool-plugins",
  "bugs": "https://github.com/zeroroot-ai/zerocool-plugins/issues",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "semgrep"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test \"dist-test/**/*.test.js\""
  },
  "dependencies": {
    "@zeroroot-ai/sdk": "^0.12.0"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "*"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.27"
  },
  "bin": {
    "zerocool-serve": "dist/serve.js",
    "zerocool-agent": "dist/serve-agent.js",
    "zerocool-dispatch": "dist/dispatch.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  }
}
