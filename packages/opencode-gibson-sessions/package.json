{
  "name": "@zeroroot-ai/zerocool-sessions",
  "version": "0.1.0",
  "description": "opencode plugin (opt-in): mirror the local session context to the trusted Gibson daemon session store, and restore it on start. opencode keeps its own storage.",
  "license": "Elastic-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zeroroot-ai/zerocool-plugins.git",
    "directory": "packages/opencode-gibson-sessions"
  },
  "homepage": "https://github.com/zeroroot-ai/zerocool-plugins",
  "bugs": "https://github.com/zeroroot-ai/zerocool-plugins/issues",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test \"dist-test/**/*.test.js\""
  },
  "dependencies": {
    "@zeroroot-ai/sdk": "^0.12.0",
    "@connectrpc/connect": "^2.0.0",
    "@connectrpc/connect-node": "^2.0.0"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "*"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.27"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
